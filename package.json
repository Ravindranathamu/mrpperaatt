{
  "name": "scan-and-go-attendance",
  "version": "1.0.0",
  "private": true,
  "description": "QR scan-and-go employee attendance system with Google sign-in, GPS geofencing, and monthly attendance sheets.",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "qr": "node scripts/make-qr.js",
    "setup:departments": "node scripts/seed-departments.js",
    "test": "node --test"
  },
  "keywords": [
    "attendance",
    "qr",
    "google-sign-in",
    "geofence",
    "express",
    "sqlite",
    "postgres"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cookie-session": "^2.1.1",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "google-auth-library": "^11.3.4",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4"
  }
}
