# ---------------------------------------------------------------------------
# Scan & Go Attendance — configuration
# Copy this file to .env and replace every value marked CHANGE ME.
# ---------------------------------------------------------------------------

# development = works on http://localhost. production = secure cookies + strict checks.
NODE_ENV=development
PORT=3000

# Shown in the app and on the printed QR poster.
COMPANY_NAME=CHANGE ME Company Name

# Branch name used as the prefix of downloaded report files, for example
# Peradeniya_attendance_2026-11-01_to_2026-11-11.csv. Leave empty for no prefix.
BRANCH_NAME=Peradeniya

# Copyright name in the page footers and QR poster. Defaults to COMPANY_NAME.
COPYRIGHT_NAME=RavSOFT

# Contact details shown next to the copyright. Leave either value empty to hide it.
CONTACT_PHONE=+94755756803
CONTACT_EMAIL=ravindranath@hotmail.co.uk

# IANA timezone used for every attendance date, report, and late calculation.
# Examples: Asia/Colombo, Asia/Kolkata, Europe/London, America/New_York, UTC.
TIMEZONE=Asia/Colombo

# ---------------------------------------------------------------------------
# Google Sign-In
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# Application type: Web application
# Authorized JavaScript origins: http://localhost:3000
# (Add your Render URL later. No redirect URI is needed.)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com

# ---------------------------------------------------------------------------
# Security
# Use a long, unique admin password. In production the app refuses to start
# with a missing, short, or well-known password.
# Generate a session secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=CHANGE_ME_Admin_Password_123!
SESSION_SECRET=CHANGE_ME_generate_a_random_64_character_string_before_deploying

# ---------------------------------------------------------------------------
# Database
# Leave DATABASE_URL empty to use a local SQLite file (zero setup).
# In production set it to a free Neon PostgreSQL connection string:
#   postgresql://user:password@host/db?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL=
# Uncomment only for a Postgres server that does not use SSL (local Postgres).
# DATABASE_SSL=false
# SQLITE_PATH=./data/attendance.db

# ---------------------------------------------------------------------------
# Office location / geofence
# Google Maps → right-click the exact spot → copy the latitude,longitude.
# Latitude first, then longitude.
# 75 m is a good starting radius. Indoor GPS can drift 20–30 m.
# ---------------------------------------------------------------------------
OFFICE_LAT=6.9271
OFFICE_LNG=79.8612
ALLOWED_RADIUS_METERS=75
MAX_GPS_ACCURACY_METERS=250

# ---------------------------------------------------------------------------
# Attendance rules
# ---------------------------------------------------------------------------
# Local office start time and grace period. Check-in after 07:10 is Late.
# These are defaults for employees without a department. Each department can
# override its shift in the admin dashboard.
WORK_START=07:00
WORK_END=16:00
GRACE_MINUTES=10

# Time when Night Body Wash hours begin. If a department named exactly
# "Night Body Wash" exists, its own start time is used instead, so you can
# change the night shift in the admin dashboard without editing this file.
NIGHT_SHIFT_START=16:00

# 1 = Monday ... 7 = Sunday. Default is Monday–Friday.
WORK_DAYS=1,2,3,4,5

# Prevent an accidental double tap from checking someone out immediately.
PUNCH_COOLDOWN_SECONDS=45

# A shift left open longer than this is not treated as today's active shift.
# It still appears in reports as an open shift for the admin to fix.
OPEN_SHIFT_HOURS=20

# ---------------------------------------------------------------------------
# Who is allowed to use the employee check-in page
# ---------------------------------------------------------------------------
# true  = a verified Google account is auto-added to the employee list.
# false = the admin must add each employee's email first.
ALLOW_SELF_REGISTRATION=true

# Optional comma-separated list, for example: mycompany.com,mycompany.lk
# Leave empty to allow any verified Google account (still geofenced).
ALLOWED_EMAIL_DOMAINS=
